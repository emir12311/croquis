# OS cruft
.DS_Store
Thumbs.db

# A saved circuit is user data, not source. The app's first Save defaults to an absolute
# name, but a relative one resolves against the working directory, so this catches
# anything that would otherwise land in the tree.
/diagram.json

# Local build toolchain (downloaded, not committed)
.toolchain/

# The trimmed toolchain that ships inside the package (scripts/build-toolchain-dist.sh)
.toolchain-dist/

# Design and release notes, kept locally (not part of the project)
personal-notes/
